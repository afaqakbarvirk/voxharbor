<include>
  <context name="default">

    <!-- 9196: echo test -->
    <extension name="echo_test">
      <condition field="destination_number" expression="^9196$">
        <action application="answer"/>
        <action application="sleep" data="500"/>
        <action application="echo"/>
      </condition>
    </extension>

    <!-- 5000: demo IVR. 1 = echo test, 2 = which node answered, 9 = repeat -->
    <extension name="demo_ivr">
      <condition field="destination_number" expression="^5000$">
        <action application="answer"/>
        <action application="sleep" data="500"/>
        <action application="playback" data="ivr/ivr-welcome_to_freeswitch.wav"/>
        <action application="set" data="ivr_menu=file_string://ivr/ivr-to_do_a_freeswitch_echo_test.wav!voicemail/vm-press.wav!digits/1.wav!silence_stream://400!ivr/ivr-for_other_options.wav!voicemail/vm-press.wav!digits/2.wav!silence_stream://400!ivr/ivr-to_repeat_these_options.wav!voicemail/vm-press.wav!digits/9.wav"/>
        <action application="play_and_get_digits" data="1 1 3 5000 # ${ivr_menu} ivr/ivr-that_was_an_invalid_entry.wav ivr_choice ^[129]$"/>
        <action application="transfer" data="ivr_${ivr_choice} XML default"/>
      </condition>
    </extension>
    <extension name="ivr_echo">
      <condition field="destination_number" expression="^ivr_1$">
        <action application="transfer" data="9196 XML default"/>
      </condition>
    </extension>
    <extension name="ivr_node">
      <condition field="destination_number" expression="^ivr_2$">
        <action application="transfer" data="9999 XML default"/>
      </condition>
    </extension>
    <extension name="ivr_repeat">
      <condition field="destination_number" expression="^ivr_9$">
        <action application="transfer" data="5000 XML default"/>
      </condition>
    </extension>
    <extension name="ivr_no_input">
      <condition field="destination_number" expression="^ivr_$">
        <action application="playback" data="ivr/ivr-thank_you_for_calling.wav"/>
        <action application="hangup"/>
      </condition>
    </extension>

    <!-- 9999: say which node answered (verifies load balancing) -->
    <extension name="which_node">
      <condition field="destination_number" expression="^9999$"/>
      <condition field="${hostname}" expression="^fs(\d+)$">
        <action application="answer"/>
        <action application="sleep" data="300"/>
        <!-- "You are number <N>" from the stock prompt pack, said twice -->
        <action application="playback" data="tone_stream://%(200,0,800)"/>
        <action application="playback" data="ivr/ivr-you_are_number.wav"/>
        <action application="playback" data="digits/$1.wav"/>
        <action application="sleep" data="600"/>
        <action application="playback" data="ivr/ivr-you_are_number.wav"/>
        <action application="playback" data="digits/$1.wav"/>
        <action application="sleep" data="500"/>
        <action application="hangup"/>
      </condition>
    </extension>

    <!-- 1001-1099: users live in Kamailio's location table; hand the B-leg back to Kamailio -->
    <extension name="local_users">
      <condition field="destination_number" expression="^(10(?:0[1-9]|[1-9][0-9]))$">
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="call_timeout=30"/>
        <action application="bridge" data="sofia/internal/$1@172.28.0.10:5070"/>
      </condition>
    </extension>

  </context>
</include>

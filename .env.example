# Host IP that softphones use to reach WSL (hostname -I, first address). Changes after WSL restarts.
EXTERNAL_IP=192.168.x.x

# SIP digest realm and the password for subscribers 1001-1099 (stored in MySQL as HA1 only)
SIP_REALM=voxharbor
SIP_USER_PASSWORD=change-me

# MySQL (never exposed to the host)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-kamailio
